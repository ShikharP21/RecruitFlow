{
  "permissions": {
    "allow": [
      "Bash(grep -v '^$')",
      "Bash(npm install *)",
      "Bash(npx prisma *)",
      "Bash(pg_isready)",
      "Bash(psql -U recruiter -d recruitflow -h localhost -c \"SELECT current_user;\")",
      "Bash(psql -l)",
      "Bash(psql -d postgres -c \"CREATE ROLE recruiter WITH LOGIN PASSWORD 'recruitflow123' CREATEDB;\")",
      "Bash(psql -d postgres -c \"CREATE DATABASE recruitflow OWNER recruiter;\")",
      "Bash(npm run *)",
      "Bash(npx next *)",
      "Bash(npx eslint *)",
      "Bash(echo \"exit: $?\")",
      "Bash(npx tsc *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(curl -s \"http://localhost:3000/api/candidates?limit=2\")",
      "Read(//private/tmp/**)",
      "Bash(curl -s -c cookies.txt -X POST http://localhost:3000/api/auth/register -H \"Content-Type: application/json\" -d '{\"name\":\"Test Recruiter\",\"email\":\"test-recruiter@example.com\",\"password\":\"test12345\",\"role\":\"recruiter\",\"gender\":\"other\"}')",
      "Bash(awk '{print $6}')",
      "Bash(curl -s \"http://localhost:3000/api/candidates?limit=1\")",
      "Bash(curl -s -b /tmp/cookies.txt http://localhost:3000/api/shortlist)",
      "Bash(curl -s http://localhost:3000/api/shortlist -w \"\\\\nstatus: %{http_code}\\\\n\")",
      "Bash(kill %1)",
      "Bash(pkill -f \"next dev\")",
      "Bash(rm -f /tmp/cookies.txt)",
      "Bash(psql -U recruiter -d recruitflow -h localhost -c \"DELETE FROM users WHERE email='test-recruiter@example.com';\")"
    ]
  }
}
